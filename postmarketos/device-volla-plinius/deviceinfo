# Reference: <https://postmarketos.org/deviceinfo>
# Please use double quotes only. You can source this file in shell scripts.
#
# DRAFT pmaports device port for the Volla Phone Plinius
# (MediaTek MT6878 / Dimensity 7300). Not yet submitted upstream; see postmarketos/README.md in karagos01/plinius-mainline.
#
# The kernel is the mainline fork linux-postmarketos-mediatek-mt6878
# (github.com/MT6878-Mainline/linux) plus the Volla Plinius bring-up stack.
# Every boot value below mirrors scripts/mk-linux-bootimg.sh, the known-good
# v2 boot.img this device actually boots from U-Boot.

deviceinfo_format_version="0"
deviceinfo_name="Volla Phone Plinius"
deviceinfo_manufacturer="Volla"
deviceinfo_codename="volla-plinius"
deviceinfo_year="2026"
deviceinfo_arch="aarch64"
deviceinfo_dtb="mediatek/mt6878-volla-plinius"
deviceinfo_append_dtb="false"

# Device related
deviceinfo_chassis="handset"
deviceinfo_drm="true"			# simpledrm over the bootloader framebuffer (DRM_SIMPLEDRM=y)
deviceinfo_external_storage="true"	# microSD (mmc1) is the proven rootfs target
deviceinfo_screen_width="1080"
deviceinfo_screen_height="2400"
deviceinfo_getty="ttyS0;921600"		# UART root console

# Kernel command line.
# No root= here: the pmOS initramfs locates the rootfs itself. earlycon +
# consoles match mk-linux-bootimg.sh.
deviceinfo_kernel_cmdline="earlycon=uart8250,mmio32,0x11001000 console=tty0 console=ttyS0,921600"

# Bootloader related.
# On-device chain: LK -> U-Boot (in boot_a) -> U-Boot loads a v2 boot.img.
# U-Boot provides "fastboot boot", so fastboot is the boot method. Permanent
# install is a dd of the generated boot.img to vendor_boot_b (see postmarketos/README.md in karagos01/plinius-mainline).
deviceinfo_flash_method="fastboot"
deviceinfo_generate_bootimg="true"
deviceinfo_header_version="2"
deviceinfo_flash_pagesize="2048"
deviceinfo_flash_offset_base="0x40000000"
deviceinfo_flash_offset_kernel="0x00080000"
deviceinfo_flash_offset_ramdisk="0x06000000"
deviceinfo_flash_offset_dtb="0x05f00000"
deviceinfo_flash_offset_second="0x00f00000"	# mkbootimg default (script does not override)
deviceinfo_flash_offset_tags="0x00000100"	# mkbootimg default (script does not override)
deviceinfo_flash_fastboot_partition_kernel="vendor_boot"
