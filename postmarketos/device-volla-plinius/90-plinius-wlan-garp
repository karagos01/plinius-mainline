#!/bin/sh
# NetworkManager dispatcher: run plinius-wlan-garp while wlan0 is up.
[ "$1" = wlan0 ] || exit 0
pidf=/run/plinius-wlan-garp.pid

stop() {
	[ -f "$pidf" ] && kill "$(cat "$pidf")" 2>/dev/null
	rm -f "$pidf"
}

case "$2" in
up)
	stop
	setsid /usr/libexec/plinius-wlan-garp >/dev/null 2>&1 </dev/null &
	echo $! > "$pidf"
	;;
down)
	stop
	;;
esac
