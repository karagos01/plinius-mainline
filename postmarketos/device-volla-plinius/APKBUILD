# Reference: <https://postmarketos.org/devicepkg>
# DRAFT device package for the Volla Phone Plinius. Not yet in pmaports.
# See postmarketos/README.md in karagos01/plinius-mainline.
maintainer="Jan Benedikt <karagos01@gmail.com>"
pkgname=device-volla-plinius
pkgdesc="Volla Phone Plinius"
pkgver=0.1
pkgrel=6
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	linux-postmarketos-mediatek-mt6878
	alsa-utils
	mkbootimg
	plinius-modemd
	postmarketos-base
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	modules-initfs
	mt6878-wifi-nvram.bin
	81-volla-plinius-sensors.rules
	ucm2/mt6878-mt6369/mt6878-mt6369.conf
	ucm2/mt6878-mt6369/HiFi.conf
	ucm2/mt6878-mt6369/VoiceCall.conf
	ucm2/mt6878-mt6369/devices.conf
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# MediaTek connac/mt7921 WiFi calibration NVRAM (the connsys firmware
	# itself is loaded from LK into EMI); without it mt7921_soc probe fails
	# "Direct firmware load for mediatek/mt6878-wifi-nvram.bin failed -2".
	install -Dm644 "$srcdir"/mt6878-wifi-nvram.bin \
		"$pkgdir"/lib/firmware/mediatek/mt6878-wifi-nvram.bin

	# ALSA UCM profile: HiFi (loudspeaker/earpiece, microphone) and Voice
	# Call (the modem's speech PCM routed to the codec, see plinius-speechd)
	local f
	for f in mt6878-mt6369.conf HiFi.conf VoiceCall.conf devices.conf; do
		install -Dm644 "$srcdir"/$f \
			"$pkgdir"/usr/share/alsa/ucm2/conf.d/mt6878-mt6369/$f
	done

	# Keep iio-sensor-proxy on the proximity sensor, not the SAR.
	install -Dm644 "$srcdir"/81-volla-plinius-sensors.rules \
		"$pkgdir"/usr/lib/udev/rules.d/81-volla-plinius-sensors.rules
}

