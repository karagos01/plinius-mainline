diff --git a/src/ipa/softisp/algorithms/af.cpp b/src/ipa/softisp/algorithms/af.cpp
new file mode 100644
index 0000000..4561b17
--- /dev/null
+++ b/src/ipa/softisp/algorithms/af.cpp
@@ -0,0 +1,304 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast based autofocus
+ *
+ * The focus measure is the energy of the differences between neighbouring
+ * pairs of green samples in the centre of the image, normalised by the
+ * squared mean signal above the black level so that it does not depend on
+ * the exposure. Samples taken while the exposure is still changing are
+ * skipped. A scan moves the lens over its whole range in coarse steps, stops
+ * once the measure has clearly dropped past a peak, and refines around the
+ * best coarse position in fine steps.
+ *
+ * In continuous mode the measure of the focused scene is kept as a reference
+ * and a new scan starts when it changes for several statistics periods in a
+ * row.
+ */
+
+#include "af.h"
+
+#include <algorithm>
+#include <cmath>
+
+#include <linux/v4l2-controls.h>
+
+#include <libcamera/base/log.h>
+
+#include <libcamera/control_ids.h>
+
+#include "libcamera/internal/software_isp/swisp_stats.h"
+
+namespace libcamera {
+
+namespace ipa::softisp::algorithms {
+
+LOG_DEFINE_CATEGORY(IPASoftIspAf)
+
+int Af::init([[maybe_unused]] IPAContext &context, const ValueNode &tuningData)
+{
+	coarseStep_ = tuningData["coarseStep"].get<int32_t>(coarseStep_);
+	fineStep_ = tuningData["fineStep"].get<int32_t>(fineStep_);
+	settleSamples_ = tuningData["settleSamples"].get<uint32_t>(settleSamples_);
+	dropRatio_ = tuningData["dropRatio"].get<double>(dropRatio_);
+	fineDropRatio_ = tuningData["fineDropRatio"].get<double>(fineDropRatio_);
+	changeRatio_ = tuningData["changeRatio"].get<double>(changeRatio_);
+	changeSamples_ = tuningData["changeSamples"].get<uint32_t>(changeSamples_);
+	maxDioptres_ = tuningData["maxDioptres"].get<float>(maxDioptres_);
+	maxExposureChange_ = tuningData["maxExposureChange"].get<double>(maxExposureChange_);
+	maxUnstableSamples_ = tuningData["maxUnstableSamples"].get<uint32_t>(maxUnstableSamples_);
+
+	if (coarseStep_ <= 0 || fineStep_ <= 0 || maxDioptres_ <= 0.0f) {
+		LOG(IPASoftIspAf, Error) << "Invalid tuning data";
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+int Af::configure(IPAContext &context, const IPAConfigInfo &configInfo)
+{
+	const auto it = configInfo.lensControls.find(V4L2_CID_FOCUS_ABSOLUTE);
+
+	hasLens_ = it != configInfo.lensControls.end();
+	context.activeState.af.enabled = hasLens_;
+
+	if (!hasLens_) {
+		context.ctrlMap.erase(&controls::AfMode);
+		context.ctrlMap.erase(&controls::AfTrigger);
+		context.ctrlMap.erase(&controls::LensPosition);
+		return 0;
+	}
+
+	/* Unpacked statistics hold the raw sensor values */
+	statsShift_ = context.sensorInfo.bitsPerPixel > 8
+		    ? context.sensorInfo.bitsPerPixel - 8 : 0;
+
+	minPos_ = it->second.min().get<int32_t>();
+	maxPos_ = it->second.max().get<int32_t>();
+	if (maxPos_ <= minPos_) {
+		hasLens_ = false;
+		context.activeState.af.enabled = false;
+		return 0;
+	}
+
+	context.ctrlMap[&controls::AfMode] =
+		ControlInfo(controls::AfModeValues, controls::AfModeContinuous);
+	context.ctrlMap[&controls::AfTrigger] =
+		ControlInfo(controls::AfTriggerValues, controls::AfTriggerStart);
+	context.ctrlMap[&controls::LensPosition] =
+		ControlInfo(0.0f, maxDioptres_, 0.0f);
+
+	mode_ = controls::AfModeContinuous;
+	manualPos_ = minPos_;
+	scan_ = Scan::Idle;
+	afState_ = controls::AfStateIdle;
+	refMeasure_ = 0.0;
+	changeCount_ = 0;
+	lastExposure_ = 0.0;
+	unstable_ = 0;
+
+	/* Start at infinity, the continuous scan starts with the first stats */
+	context.activeState.af.position = minPos_;
+	startScan(context);
+
+	return 0;
+}
+
+void Af::queueRequest(IPAContext &context,
+		      [[maybe_unused]] const uint32_t frame,
+		      [[maybe_unused]] IPAFrameContext &frameContext,
+		      const ControlList &controls)
+{
+	if (!hasLens_)
+		return;
+
+	const auto &mode = controls.get(controls::AfMode);
+	if (mode && *mode != mode_) {
+		mode_ = *mode;
+		LOG(IPASoftIspAf, Debug) << "AF mode " << mode_;
+
+		if (mode_ == controls::AfModeManual) {
+			scan_ = Scan::Idle;
+			afState_ = controls::AfStateIdle;
+			moveTo(context, manualPos_);
+		} else if (mode_ == controls::AfModeContinuous) {
+			startScan(context);
+		} else {
+			scan_ = Scan::Idle;
+			afState_ = controls::AfStateIdle;
+		}
+	}
+
+	const auto &position = controls.get(controls::LensPosition);
+	if (position) {
+		manualPos_ = dioptresToPosition(*position);
+		if (mode_ == controls::AfModeManual)
+			moveTo(context, manualPos_);
+	}
+
+	const auto &trigger = controls.get(controls::AfTrigger);
+	if (trigger && mode_ == controls::AfModeAuto) {
+		if (*trigger == controls::AfTriggerStart) {
+			startScan(context);
+		} else if (*trigger == controls::AfTriggerCancel) {
+			scan_ = Scan::Idle;
+			afState_ = controls::AfStateIdle;
+		}
+	}
+}
+
+void Af::startScan(IPAContext &context)
+{
+	scan_ = Scan::Coarse;
+	afState_ = controls::AfStateScanning;
+	scanStep_ = coarseStep_;
+	scanEnd_ = maxPos_;
+	bestPos_ = minPos_;
+	bestMeasure_ = 0.0;
+	changeCount_ = 0;
+	moveTo(context, minPos_);
+}
+
+void Af::moveTo(IPAContext &context, int32_t position)
+{
+	position = std::clamp(position, minPos_, maxPos_);
+	scanPos_ = position;
+	if (context.activeState.af.position != position)
+		context.activeState.af.position = position;
+
+	/* Wait until the lens has settled before using the statistics */
+	settle_ = settleSamples_;
+}
+
+void Af::finishScan(IPAContext &context, bool found)
+{
+	scan_ = Scan::Idle;
+	afState_ = found ? controls::AfStateFocused : controls::AfStateFailed;
+	refMeasure_ = bestMeasure_;
+	changeCount_ = 0;
+	moveTo(context, bestPos_);
+
+	LOG(IPASoftIspAf, Debug)
+		<< "Scan done at " << bestPos_ << ", measure " << bestMeasure_;
+}
+
+void Af::scanStep(IPAContext &context, double measure)
+{
+	if (measure > bestMeasure_) {
+		bestMeasure_ = measure;
+		bestPos_ = scanPos_;
+	}
+
+	/* The measure has clearly dropped past a peak: stop this pass */
+	double drop = scan_ == Scan::Coarse ? dropRatio_ : fineDropRatio_;
+	bool passedPeak = bestMeasure_ > 0.0 && measure < bestMeasure_ * drop;
+
+	int32_t next = scanPos_ + scanStep_;
+	if (!passedPeak && next <= scanEnd_) {
+		moveTo(context, next);
+		return;
+	}
+
+	if (scan_ == Scan::Coarse) {
+		/* Refine around the best coarse position */
+		scan_ = Scan::Fine;
+		scanStep_ = fineStep_;
+		scanEnd_ = std::min(bestPos_ + coarseStep_, maxPos_);
+		int32_t start = std::max(bestPos_ - coarseStep_, minPos_);
+		bestMeasure_ = 0.0;
+		moveTo(context, start);
+		return;
+	}
+
+	finishScan(context, bestMeasure_ > 0.0);
+}
+
+void Af::process(IPAContext &context,
+		 [[maybe_unused]] const uint32_t frame,
+		 IPAFrameContext &frameContext,
+		 const SwIspStats *stats,
+		 ControlList &metadata)
+{
+	if (!hasLens_)
+		return;
+
+	metadata.set(controls::AfState, afState_);
+	metadata.set(controls::LensPosition,
+		     positionToDioptres(context.activeState.af.position));
+
+	if (!stats->valid || !stats->focusCount || !stats->focusSum)
+		return;
+
+	/* Normalise by the mean signal above the black level */
+	double black = static_cast<double>(context.activeState.blc.level << statsShift_);
+	double mean = static_cast<double>(stats->focusSum) / stats->focusCount;
+	double signal = std::max(mean - black, static_cast<double>(1 << statsShift_));
+	/* One difference per pair of samples, between sums of two samples */
+	double measure = static_cast<double>(stats->focusSumSq) /
+			 (stats->focusCount / 2.0) / (4.0 * signal * signal);
+	metadata.set(controls::FocusFoM, static_cast<int32_t>(measure * 1e3));
+
+	double exposure = frameContext.sensor.exposure * frameContext.sensor.gain;
+	bool stable = lastExposure_ > 0.0 &&
+		      std::abs(exposure / lastExposure_ - 1.0) <= maxExposureChange_;
+	lastExposure_ = exposure;
+
+	LOG(IPASoftIspAf, Debug)
+		<< "pos " << context.activeState.af.position
+		<< " measure " << measure << " signal " << signal
+		<< " exposure " << exposure << " settle " << settle_
+		<< " scan " << static_cast<int>(scan_);
+
+	/*
+	 * Skip the samples taken while the exposure changes, unless it does not
+	 * settle at all.
+	 */
+	if (!stable && unstable_ < maxUnstableSamples_) {
+		unstable_++;
+		return;
+	}
+	unstable_ = 0;
+
+	if (settle_) {
+		settle_--;
+		return;
+	}
+
+	if (scan_ != Scan::Idle) {
+		scanStep(context, measure);
+		return;
+	}
+
+	if (mode_ != controls::AfModeContinuous || refMeasure_ <= 0.0)
+		return;
+
+	/* Rescan when the scene keeps differing from the focused one */
+	double change = std::abs(measure - refMeasure_) / refMeasure_;
+	if (change > changeRatio_) {
+		if (++changeCount_ >= changeSamples_) {
+			LOG(IPASoftIspAf, Debug)
+				<< "Scene changed (" << change << "), rescanning";
+			startScan(context);
+		}
+	} else {
+		changeCount_ = 0;
+	}
+}
+
+float Af::positionToDioptres(int32_t position) const
+{
+	return static_cast<float>(position - minPos_) * maxDioptres_ /
+	       (maxPos_ - minPos_);
+}
+
+int32_t Af::dioptresToPosition(float dioptres) const
+{
+	return minPos_ + static_cast<int32_t>(std::lround(dioptres * (maxPos_ - minPos_) /
+							  maxDioptres_));
+}
+
+REGISTER_IPA_ALGORITHM(Af, "Af")
+
+} /* namespace ipa::softisp::algorithms */
+
+} /* namespace libcamera */
diff --git a/src/ipa/softisp/algorithms/af.h b/src/ipa/softisp/algorithms/af.h
new file mode 100644
index 0000000..051b470
--- /dev/null
+++ b/src/ipa/softisp/algorithms/af.h
@@ -0,0 +1,91 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast based autofocus
+ */
+
+#pragma once
+
+#include <stdint.h>
+
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::softisp::algorithms {
+
+class Af : public Algorithm
+{
+public:
+	Af() = default;
+	~Af() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context, const IPAConfigInfo &configInfo) override;
+	void queueRequest(IPAContext &context, const uint32_t frame,
+			  IPAFrameContext &frameContext,
+			  const ControlList &controls) override;
+	void process(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     const SwIspStats *stats,
+		     ControlList &metadata) override;
+
+private:
+	enum class Scan {
+		Idle,
+		Coarse,
+		Fine,
+	};
+
+	void startScan(IPAContext &context);
+	void moveTo(IPAContext &context, int32_t position);
+	void scanStep(IPAContext &context, double measure);
+	void finishScan(IPAContext &context, bool found);
+	float positionToDioptres(int32_t position) const;
+	int32_t dioptresToPosition(float dioptres) const;
+
+	/* Tuning */
+	int32_t coarseStep_ = 64;
+	int32_t fineStep_ = 16;
+	unsigned int settleSamples_ = 0;
+	double dropRatio_ = 0.6;
+	double fineDropRatio_ = 0.85;
+	double changeRatio_ = 0.35;
+	unsigned int changeSamples_ = 3;
+	float maxDioptres_ = 10.0f;
+	double maxExposureChange_ = 0.05;
+	unsigned int maxUnstableSamples_ = 8;
+
+	/* Lens range */
+	bool hasLens_ = false;
+	int32_t minPos_ = 0;
+	int32_t maxPos_ = 0;
+
+	/* Scale from the 8-bit black level to the statistics values */
+	unsigned int statsShift_ = 0;
+
+	/* Requested mode */
+	int32_t mode_ = 0;
+	int32_t manualPos_ = 0;
+
+	/* Scan state */
+	Scan scan_ = Scan::Idle;
+	int32_t afState_ = 0;
+	int32_t scanPos_ = 0;
+	int32_t scanEnd_ = 0;
+	int32_t scanStep_ = 0;
+	int32_t bestPos_ = 0;
+	double bestMeasure_ = 0.0;
+	unsigned int settle_ = 0;
+
+	/* Exposure stability */
+	double lastExposure_ = 0.0;
+	unsigned int unstable_ = 0;
+
+	/* Continuous monitoring */
+	double refMeasure_ = 0.0;
+	unsigned int changeCount_ = 0;
+};
+
+} /* namespace ipa::softisp::algorithms */
+
+} /* namespace libcamera */
