# DRAFT package for the Volla Phone Plinius. Not yet in pmaports.
# See postmarketos/README.md in karagos01/plinius-mainline.
#
# Mesa for the Waydroid vendor image, prebuilt with the Android NDK by
# postmarketos/waydroid-mesa.sh (the NDK only runs on x86_64 hosts, so it
# cannot be built inside the aarch64 build chroot). The archive is copied
# here by postmarketos/install-pmaports.sh and is not kept in git.
maintainer="Jan Benedikt <karagos01@gmail.com>"
pkgname=waydroid-plinius
pkgver=26.3.1
pkgrel=0
pkgdesc="Waydroid integration for the Volla Phone Plinius: Mali-G615 Mesa, Android apps in their own windows"
url="https://github.com/karagos01/plinius-mainline"
arch="aarch64"
license="MIT"
depends="python3 waydroid waydroid-nftrules"
install="$pkgname.post-install $pkgname.post-upgrade $pkgname.pre-deinstall"
source="
	waydroid-mesa-overlay.tar.gz
	waydroid-plinius-setup
"
# Android binaries: nothing to check, strip or trace on the host side
options="!check !strip !tracedeps"

package() {
	install -d "$pkgdir"/var/lib/waydroid/overlay
	cp -r "$srcdir"/vendor "$pkgdir"/var/lib/waydroid/overlay/
	install -Dm755 "$srcdir"/waydroid-plinius-setup \
		"$pkgdir"/usr/libexec/waydroid-plinius-setup
	# The pmOS firewall otherwise drops DHCP, DNS and forwarding from waydroid0
	install -d "$pkgdir"/etc/nftables.d
	ln -s /usr/share/nftables.avail/51_waydroid.nft \
		"$pkgdir"/etc/nftables.d/51_waydroid.nft
}

sha512sums="
ae4ea949b5f93bce1cce81138d2493624bb61671af6cf97f5a8a70125dfca984828d235a3685461b2dd7ce34a95a53b1371ff2e7065fda2476d3f6ef6828ba64  waydroid-mesa-overlay.tar.gz
d7a9081a37e8aa82f7e51119d835186ad6c12ad12df0c1980481a2b370c6d2528b4f577d6a376627ee8b8c23c9c07760097f0a823203a3e646d747c96c868664  waydroid-plinius-setup
"
