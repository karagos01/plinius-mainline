38f7664e93dac8cef7c67668f5e5bcddd551b363119e97eabdb8733bcd57477a571fbcdeea34d4a2cc8668b66b7613bf8ae5a3dc9bd7870582d1a133feb47ad1  waydroid-plinius-setup
197b3bbb09dfd7215e60be15d2f959b06e6a36a524ee1ebfa7dfc82d0aabb6f9c7f7bbad784a32c67202d704e7ad8faa92bf59436b1e2b7982cffb57c8c235c4  waydroid-plinius-share
927b6915ad4e1df0bf9a6e29779bc672cbac9c705f6b663f3e394886f5101219f53d259743f55dc9f26278fbdfae51077298e925ed881f3c3424f30a51341e59  waydroid-plinius.initd
