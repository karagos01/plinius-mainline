#!/bin/sh
/usr/libexec/waydroid-plinius-setup --remove
/usr/libexec/waydroid-plinius-hwc --remove
rc-update -q del waydroid-plinius default
# Give Android its own keyboard back (only possible while it runs)
rm -f /var/lib/waydroid/plinius-ime-selected
waydroid shell -- ime set com.android.inputmethod.latin/.LatinIME >/dev/null 2>&1
exit 0
