#!/sbin/openrc-run

description="Waydroid storage as ~/Android, the pmOS keyboard and hwcomposer shim"

depend() {
	need localmount
	before waydroid-container
}

start() {
	ebegin "Sharing the Waydroid storage"
	/usr/libexec/waydroid-plinius-share
	eend $? || return 1
	ebegin "Installing the hwcomposer shim"
	/usr/libexec/waydroid-plinius-hwc
	eend $?
	# Returns at once; waits in the background for Android to boot
	/usr/libexec/waydroid-plinius-ime
}
