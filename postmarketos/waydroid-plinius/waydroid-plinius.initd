#!/sbin/openrc-run

description="Waydroid storage as ~/Android and the pmOS keyboard in Android"

depend() {
	need localmount
	before waydroid-container
}

start() {
	ebegin "Sharing the Waydroid storage"
	/usr/libexec/waydroid-plinius-share
	eend $? || return 1
	# Returns at once; waits in the background for Android to boot
	/usr/libexec/waydroid-plinius-ime
}
