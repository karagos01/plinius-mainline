#!/bin/sh
/usr/libexec/waydroid-plinius-setup
# Used from the next container start on
/usr/libexec/waydroid-plinius-hwc
rc-update -q add waydroid-container default
rc-update -q add waydroid-plinius default
rc-service -q waydroid-plinius start
rc-service -q nftables reload 2>/dev/null
# Already running services are not restarted; select the keyboard anyway
/usr/libexec/waydroid-plinius-ime
exit 0
