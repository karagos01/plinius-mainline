c016ad03576b5598d1c816abb54689d56f79f5ba1ef23ade9f8c77c662d37fd4d9185d913512f64e6e86e340960860c938b3756dbbacf8f181a2e307c7b8309d  0001-pulse-switch-the-voice-call-profile-for-the-speaker.patch
"
