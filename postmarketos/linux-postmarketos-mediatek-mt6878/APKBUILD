e1c40af8cfc27b103d371fb4dfa8ec8fe35f1b7eeaad9ccd972ab5fc49e551aed61b9036bfb0cd02e4d2def148c5c0270916804cbbb2415a23e4fe978ba8d791  config-postmarketos-mediatek-mt6878.aarch64
"
