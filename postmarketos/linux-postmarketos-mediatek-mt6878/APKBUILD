c6e5139c773117924199c04d108fd16d49f291f80b1fd244f8789fed72ed1da0211f01914535319e5d9b158dc59f30054c583ce4963c91400bfad81017ebb3d9  config-postmarketos-mediatek-mt6878.aarch64
"
