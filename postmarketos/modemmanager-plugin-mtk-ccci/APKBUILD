# DRAFT package for the Volla Phone Plinius. Not yet in pmaports.
# See postmarketos/README.md in karagos01/plinius-mainline.
#
# ModemManager plugin for MediaTek modems behind the mainline CCCI driver
# (mtk-ccci): +EIF data bearers over the ccmni net devices and incoming
# call approval over MIPC. The sources are in mm-plugin-mtk-ccci/ of
# plinius-mainline (copied in by install-pmaports.sh). Plugins use ModemManager's internal API, so this
# builds against the exact ModemManager source and configuration of
# Alpine's modemmanager package and must be rebuilt with it.
maintainer="Jan Benedikt <karagos01@gmail.com>"
pkgname=modemmanager-plugin-mtk-ccci
pkgver=0.1.0
pkgrel=1
_mmver=1.25.95_git20261005
_mmrel=0
_mmcommit=7f0bf17ab518cd78925cf7e53cc0d5c42f88b41a
pkgdesc="ModemManager plugin for MediaTek CCCI modems (Volla Phone Plinius)"
url="https://github.com/karagos01/plinius-mainline"
arch="aarch64"
license="GPL-2.0-or-later"
depends="modemmanager=$_mmver-r$_mmrel"
install_if="device-volla-plinius modemmanager"
makedepends="
	dbus-dev
	elogind-dev
	glib-dev
	libgudev-dev
	libmm-glib
	libmbim-dev
	libqmi-dev
	libqrtr-glib-dev
	linux-headers
	meson
	polkit-dev
	"
_files="
	mm-plugin-mtk-ccci.c
	mm-broadband-modem-mtk-ccci.c
	mm-broadband-modem-mtk-ccci.h
	mm-broadband-bearer-mtk-ccci.c
	mm-broadband-bearer-mtk-ccci.h
	mm-mtk-ccci-mipc.c
	mm-mtk-ccci-mipc.h
	"
source="https://gitlab.freedesktop.org/mobile-broadband/ModemManager/-/archive/$_mmcommit/ModemManager-$_mmcommit.tar.gz
	$_files
	"
builddir="$srcdir/ModemManager-$_mmcommit"
options="!check"

prepare() {
	default_prepare
	mkdir -p src/plugins/mtk-ccci
	for f in $_files; do
		cp "$srcdir/$f" src/plugins/mtk-ccci/
	done
	# register the plugin next to the in-tree ones
	awk '/^builtin_sources = \[\]/ && !done {
		print "# plugin: mtk-ccci (out of tree)"
		print "plugins += {\x27plugin-mtk-ccci\x27: {"
		print "  \x27plugin\x27: true,"
		print "  \x27module\x27: {\x27sources\x27: files(\x27mtk-ccci/mm-plugin-mtk-ccci.c\x27, \x27mtk-ccci/mm-broadband-modem-mtk-ccci.c\x27, \x27mtk-ccci/mm-broadband-bearer-mtk-ccci.c\x27, \x27mtk-ccci/mm-mtk-ccci-mipc.c\x27), \x27include_directories\x27: plugins_incs, \x27c_args\x27: \x27-DMM_MODULE_NAME=\"mtk-ccci\"\x27},"
		print "}}"
		print ""
		done = 1
	} { print }' src/plugins/meson.build > meson.build.new
	mv meson.build.new src/plugins/meson.build
	grep -q plugin-mtk-ccci src/plugins/meson.build
}

build() {
	# the configuration of Alpine's modemmanager (struct layouts depend on it)
	abuild-meson \
		-Db_lto=true \
		-Dsystemdsystemunitdir=/usr/lib/systemd/system \
		-Ddbus_policy_dir=/usr/share/dbus-1/system.d \
		-Dgtk_doc=false \
		-Dpolkit=permissive \
		-Dsystemd_journal=false \
		-Dsystemd_suspend_resume=true \
		-Dintrospection=false \
		-Dvapi=false \
		-Dbash_completion=false \
		-Dtests=false \
		. output
	meson compile -C output mm-plugin-mtk-ccci
}

package() {
	install -Dm755 output/src/plugins/libmm-plugin-mtk-ccci.so \
		"$pkgdir"/usr/lib/ModemManager/libmm-plugin-mtk-ccci.so
}

